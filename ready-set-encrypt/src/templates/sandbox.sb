(version 1)
(deny default)
(allow process-fork)
(allow process-exec)
(allow signal (target self))
(allow mach-lookup)
(allow sysctl-read)
(allow file-read*)
(allow network*)
(allow file-write*
  (subpath "<PROJECT_ROOT>")
  (subpath "<TMPDIR>")
  (subpath "<HOME>/Library/Caches")
<EXTRA_WRITES>)
(deny file-write*
  (subpath "<HOME>/.ssh")
  (subpath "<HOME>/.gnupg")
  (literal "<HOME>/.zshrc")
  (literal "<HOME>/.bashrc")
  (literal "<HOME>/.profile")
  (literal "<HOME>/.bash_profile")
  (literal "<HOME>/.zprofile")
  (literal "<HOME>/.zshenv"))
