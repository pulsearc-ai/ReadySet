{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ready-set.dev/schemas/capability-report.schema.json",
  "title": "ready-set capability report",
  "description": "Read-only readiness status for one product capability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "provider", "state", "relevance", "summary", "next_action"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)?$"
    },
    "state": {
      "type": "string",
      "enum": ["ready", "missing", "incomplete", "blocked", "stale", "optional", "not-needed"]
    },
    "relevance": {
      "type": "string",
      "enum": ["required", "optional", "not-needed"]
    },
    "summary": {
      "type": "string"
    },
    "next_action": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "description"],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
