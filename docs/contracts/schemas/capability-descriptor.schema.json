{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ready-set.dev/schemas/capability-descriptor.schema.json",
  "title": "ready-set capability descriptor",
  "description": "Static metadata for one product capability provided by a built-in or plugin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "provider", "verbs", "default_relevance"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)?$"
    },
    "verbs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["ready", "set", "go"]
      }
    },
    "default_relevance": {
      "type": "string",
      "enum": ["required", "optional", "not-needed"]
    }
  }
}
